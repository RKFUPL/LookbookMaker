# Public application origin. Render production uses this for canonical URLs,
# Open Graph metadata, and shareable catalog links.
APP_URL=https://lookbookmaker.onrender.com
PORT=10000

# MongoDB stores catalog metadata, users, and analytics events. PDF bytes stay
# on the external HTTPS source URL and are read by PDF.js in the browser.
MONGODB_URI=mongodb+srv://rk_db_user:<PASSWORD>@rkdb.example.mongodb.net/heyzine?retryWrites=true&w=majority

# Use a long random value (at least 32 characters).
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_HOURS=12

# Zoho WorkDrive OAuth and storage. Set the URLs for your WorkDrive data center.
ZOHO_WORKDRIVE_API_BASE_URL=https://www.zohoapis.in
ZOHO_WORKDRIVE_UPLOAD_BASE_URL=https://upload.zoho.in
ZOHO_WORKDRIVE_DOWNLOAD_BASE_URL=https://download.zoho.in
ZOHO_OAUTH_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_WORKDRIVE_CLIENT_ID=
ZOHO_WORKDRIVE_CLIENT_SECRET=
ZOHO_WORKDRIVE_REFRESH_TOKEN=
ZOHO_WORKDRIVE_FOLDER_ID=
ZOHO_WORKDRIVE_MAX_UPLOAD_MB=100

# Optional local Windows override when Node reports a loopback DNS server
# (for example 127.0.0.1) that refuses MongoDB Atlas SRV lookups.
# Comma-separated DNS server IPs; production does not use this setting.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Used by `npm run seed:admin`.
BOOTSTRAP_ADMIN_EMAIL=staff@rashikapoorofficial.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production
BOOTSTRAP_ADMIN_NAME=RK Staff
