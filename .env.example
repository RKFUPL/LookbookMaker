# Server-side public application URL, without a trailing slash.
# Production must use the HTTPS Render/custom-domain URL.
APP_URL=https://<your-render-service>.onrender.com
PORT=10000

# Use local storage for development. Production uses the R2 settings below.
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=data/objects

# MongoDB stores catalog/user/job metadata only
MONGODB_URI=mongodb+srv://rk_db_user:<PASSWORD>@rkdb.6dewe49.mongodb.net/heyzine?retryWrites=true&w=majority

# Use a long random value (at least 32 characters)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_HOURS=12

SIGNED_URL_TTL_SECONDS=3600
MAX_PDF_SIZE_MB=250
MAX_COVER_SIZE_MB=10

# Cloudflare R2 / S3-compatible production storage.
# Set STORAGE_DRIVER=s3 in production. Never expose these credentials to the browser.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET=rk-catalogs
# R2_ACCESS_KEY_ID=<server-only-access-key>
# R2_SECRET_ACCESS_KEY=<server-only-secret-key>
# R2_PUBLIC_BASE_URL=https://cdn.rashikapoorofficial.com
# R2_FORCE_PATH_STYLE=false

# PDF worker binaries. The Docker image includes these.
PDFINFO_BIN=pdfinfo
PDFTOPPM_BIN=pdftoppm
WORKER_POLL_MS=2500
WORKER_MAX_ATTEMPTS=3

# Used by `npm run seed:admin`
BOOTSTRAP_ADMIN_EMAIL=staff@rashikapoorofficial.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production
BOOTSTRAP_ADMIN_NAME=RK Staff
