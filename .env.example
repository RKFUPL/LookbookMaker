# Public application origin. Render production uses this for canonical URLs,
# Open Graph metadata, and shareable catalog links.
APP_URL=https://lookbookmaker.onrender.com
PORT=10000

# MongoDB stores catalog metadata, users, and analytics events. PDF bytes stay
# on the external HTTPS source URL and are read by PDF.js in the browser.
MONGODB_URI=mongodb+srv://rk_db_user:<PASSWORD>@rkdb.example.mongodb.net/heyzine?retryWrites=true&w=majority

# Use a long random value (at least 32 characters).
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_HOURS=12

# Used by `npm run seed:admin`.
BOOTSTRAP_ADMIN_EMAIL=staff@rashikapoorofficial.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production
BOOTSTRAP_ADMIN_NAME=RK Staff
