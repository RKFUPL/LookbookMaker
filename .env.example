# Public application URL, without a trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use local filesystem objects only for development. Production should use s3.
STORAGE_DRIVER=s3
LOCAL_STORAGE_ROOT=data/objects

# MongoDB stores catalog/user/job metadata only
MONGODB_URI=mongodb://localhost:27017/rk_catalogs

# Use a long random value (at least 32 characters)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_HOURS=12

# Cloudflare R2, AWS S3, MinIO, or another S3-compatible service
S3_ENDPOINT=http://localhost:9000
# Browser-reachable S3 endpoint used when signing direct uploads/downloads.
# Usually the same as S3_ENDPOINT; Docker Compose uses localhost here and minio internally above.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=rk-catalogs
S3_ACCESS_KEY_ID=rk-local
S3_SECRET_ACCESS_KEY=rk-local-secret
S3_FORCE_PATH_STYLE=true

# Optional public CDN/base URL for optimized page assets. Leave blank to use signed URLs.
STORAGE_PUBLIC_BASE_URL=
SIGNED_URL_TTL_SECONDS=3600
MAX_PDF_SIZE_MB=250
MAX_COVER_SIZE_MB=10

# PDF worker binaries. The Docker image includes these.
PDFINFO_BIN=pdfinfo
PDFTOPPM_BIN=pdftoppm
WORKER_POLL_MS=2500
WORKER_MAX_ATTEMPTS=3

# Used by `npm run seed:admin`
BOOTSTRAP_ADMIN_EMAIL=staff@rashikapoorofficial.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production
BOOTSTRAP_ADMIN_NAME=RK Staff
